{
  "name": "mc-browser-v2",
  "version": "1.0.0",
  "description": "MC Browser — Privacy First Desktop Browser",
  "main": "main.js",
  "author": "MC Browser",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "set MC_DEV=1 && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "30.0.9",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mcbrowser.v2",
    "productName": "MC Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "perchance/**/*",
      "src/**/*",
      "modules/**/*",
      "preload/**/*",
      "assets/**/*",
      "favicon/**/*",
      "package.json",
      "package-lock.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "protocols": [
      {
        "name": "MC Browser HTTP",
        "schemes": [
          "http"
        ],
        "role": "Viewer"
      },
      {
        "name": "MC Browser HTTPS",
        "schemes": [
          "https"
        ],
        "role": "Viewer"
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "description": "HTML Web Page",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "description": "HTML Web Page",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MC Browser"
    }
  }
}
